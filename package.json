{
  "name": "ci-cd-pipeline-app",
  "version": "1.1.0",
  "description": "Production-ready CI/CD Pipeline with Docker, Prometheus, and Grafana",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "jest --forceExit --detectOpenHandles --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "open": "open http://localhost:3000 http://localhost:9090 http://localhost:3001",
    "docker:up": "colima status || colima start; docker compose up -d --build && open http://localhost:3000 http://localhost:9090 http://localhost:3001",
    "docker:down": "docker compose down",
    "traffic": "node traffic-gen.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "json-summary"],
    "collectCoverageFrom": ["app.js", "!tests/**", "!node_modules/**"],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 60,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["ci-cd", "docker", "prometheus", "grafana", "devops", "pipeline"],
  "license": "MIT"
}
