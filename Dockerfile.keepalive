FROM alpine:3.20

RUN apk add --no-cache curl

CMD ["sh", "-c", \
  "echo '--- Keep-Alive Ping ---' && \
   curl -sf --max-time 30 https://ci-cd-pipeline-automation-app.onrender.com/health && echo '✓ App OK' || echo '✗ App unreachable' && \
   curl -sf --max-time 30 https://prometheus-monitoring-service.onrender.com/-/healthy && echo '✓ Prometheus OK' || echo '✗ Prometheus unreachable' && \
   curl -sf --max-time 30 https://grafana-dashboard-service.onrender.com/api/health && echo '✓ Grafana OK' || echo '✗ Grafana unreachable' && \
   echo '--- Done ---'"]
